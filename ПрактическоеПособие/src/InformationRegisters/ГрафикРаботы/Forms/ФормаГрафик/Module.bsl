&НаКлиенте
Процедура ЗаполнитьГрафик(Команда)
	ЗаполнитьГрафикНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Массив = Новый Массив;
	Массив.Добавить("Понедельник");
	Массив.Добавить("Вторник");
	Массив.Добавить("Среда");
	Массив.Добавить("Четверг");
	Массив.Добавить("Пятница");
	Массив.Добавить("Суббота");
	Массив.Добавить("Воскресенье");
	
	ДеньНедели = 0;
	КолВоДнейНедели = 7;
	
	Пока ДеньНедели < КолВоДнейНедели Цикл
		
		НоваяСтрока = ШаблонДниНедели.Добавить();
		НоваяСтрока.ДеньНедели = Массив[ДеньНедели];
		
		ДеньНедели = ДеньНедели + 1;
		
	КонецЦикла;
	
	
КонецПроцедуры