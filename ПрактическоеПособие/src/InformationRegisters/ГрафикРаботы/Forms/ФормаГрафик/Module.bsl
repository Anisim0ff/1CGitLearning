
&НаСервере
Процедура ЗаполнитьГрафикНаСервере()
	
	ДатаНачала = Период.ДатаНачала;
	ДатаОкончания = Период.ДатаОкончания;
	Дата = ДатаНачала;
	
	ТЗ = РеквизитФормыВЗначение("ШаблонДниНедели");
	
	Пока Дата <= ДатаОкончания Цикл
		
		СтрокаТЗ = ТЗ[ДеньНедели(Дата) - 1];
		
		Если СтрокаТЗ.Включать = Истина Тогда
			МенеджерЗаписи = РегистрыСведений.ГрафикРаботы.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ГрафикРаботы = ГрафикРаботы;
			МенеджерЗаписи.Дата = Дата;
			МенеджерЗаписи.Значение = Истина;
			МенеджерЗаписи.Записать();
		Иначе
			МенеджерЗаписи = РегистрыСведений.ГрафикРаботы.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ГрафикРаботы = ГрафикРаботы;
			МенеджерЗаписи.Дата = Дата;
			МенеджерЗаписи.Значение = Ложь;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		Дата = НачалоДня(Дата + (60 * 60 * 24)); 
		
	КонецЦикла;
	
